  "faq": {
    "kicker": "Help Center",
    "title": "Frequently Asked Questions",
    "subtitle": "Find quick answers to the most common questions about shopping at Tamara Land.",
    "items": {
      "order": {
        "q": "How do I place an order?",
        "a": "Browse our catalog, select your size and color, then add items to your cart. When you're ready, proceed to checkout, enter your delivery address and confirm your order."
      },
      "shipping": {
        "q": "How long does delivery take?",
        "a": "Most orders are delivered within 2\u20134 business days. Delivery time may vary based on your location and courier availability."
      },
      "returns": {
        "q": "Can I return an item?",
        "a": "Yes. Items can be returned within 14 days of delivery, provided they are unused, unwashed, and in original packaging. Some items like swimwear are non-returnable."
      },
      "sizes": {
        "q": "How do I find the right size?",
        "a": "Each product page includes a detailed size guide with measurements in centimeters. If you're between sizes, we recommend sizing up for comfort."
      },
      "payment": {
        "q": "What payment methods are accepted?",
        "a": "We currently accept Cash on Delivery. Online payment options will be available soon."
      },
      "cancel": {
        "q": "Can I cancel my order?",
        "a": "Orders can be cancelled before they are shipped. Please contact us as soon as possible via WhatsApp if you need to cancel."
      },
      "track": {
        "q": "How do I track my order?",
        "a": "You'll receive WhatsApp updates at each stage of your order. You can also view your order status in real time from the My Orders page."
      },
      "gift": {
        "q": "Do you offer gift wrapping?",
        "a": "We currently do not offer gift wrapping, but all Tamara Land orders are packed with care and elegance."
      }
    }
  },
  "privacy": {
    "kicker": "Your Privacy",
    "title": "Privacy Policy",
    "subtitle": "We are committed to protecting your personal information and your right to privacy.",
    "notice": "This policy was last updated in 2025 and applies to all users of the Tamara Land platform.",
    "sections": {
      "collect": {
        "title": "Information We Collect",
        "body": "We collect information you provide directly to us, such as your name, email address, phone number, and delivery address when you register or place an order."
      },
      "use": {
        "title": "How We Use Your Information",
        "body": "Your information is used to process your orders, send delivery updates, and improve our services. We do not sell your data to third parties."
      },
      "security": {
        "title": "Data Security",
        "body": "We implement industry-standard security measures including encrypted data storage and secure HTTPS connections to protect your personal information."
      },
      "rights": {
        "title": "Your Rights",
        "body": "You have the right to access, correct, or delete your personal data at any time. To exercise these rights, please contact our support team."
      },
      "contact": {
        "title": "Contact Us",
        "body": "If you have any questions about this privacy policy or how we handle your data, please reach out to our support team via email or WhatsApp."
      }
    }
  },
